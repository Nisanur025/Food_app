<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".AllRecipesFragment"
    android:id="@+id/AllRecipe_Fragment"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/header_allRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_recipes_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_recipes_count"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="24dp"
                android:gravity="end" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_square_black_stroke"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/light_grey"
            android:drawablePadding="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_allRecipes"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            android:hint="@string/search_hint"
            android:textColorHint="@color/light_grey"
            android:textColor="@color/white"
            android:autofillHints="name"
            android:inputType="text" />

        <HorizontalScrollView
            android:id="@+id/horizontal_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_search"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/filter_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/black"
                    android:padding="6dp"
                    android:background="@drawable/bg_filter"
                    android:layout_marginEnd="12dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/filter_all" />

                <!-- Aktif Buton (Tümü) -->
                <Button
                    android:id="@+id/FilterAllBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/filter_all"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_today_menu"
                    android:layout_marginEnd="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/active_pink" />

                <!--Filtre Butonları-->
                <Button
                    android:id="@+id/FilterBreakFastBtn"
                    style="@style/FilterButtonStyle"
                    android:text="@string/filter_breakfast" />

                <Button
                    android:id="@+id/FilterMainDishBtn"
                    style="@style/FilterButtonStyle"
                    android:text="@string/filter_main_dish" />

                <Button
                    android:id="@+id/FilterDessertBtn"
                    style="@style/FilterButtonStyle"
                    android:text="@string/filter_dessert"
                    android:layout_marginEnd="0dp" />
            </LinearLayout>

        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/frame_recipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/horizontal_bar"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRecipes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                tools:listitem="@layout/rv_item_recipe" />
        </FrameLayout>

        <!--TODO: FAB Yukarı çıkma-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>