<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".AllRecipesFragment"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/header_allRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tüm Tarifler"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="128 Tarif"
                android:textSize="16sp"
                android:textColor="#5A5A5A"
                android:layout_marginTop="2dp"
                android:layout_marginRight="24dp"
                android:gravity="right"
                />
        </LinearLayout>

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_square_black_stroke"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/light_grey"
            android:drawablePadding="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_allRecipes"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            android:hint="Tarif, malzeme ara..."
            android:textColorHint="@color/light_grey"
            android:textColor="@color/white"
            />

        <HorizontalScrollView
            android:id="@+id/horizontal_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_search"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:scrollbarSize="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/filter_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/black"
                    android:padding="6dp"
                    android:drawableTint="@color/black"
                    android:background="@drawable/bg_filter"
                    android:layout_marginEnd="12dp"
                    android:layout_gravity="center"/>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Tümü"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_today_menu"
                    android:layout_marginEnd="12dp"
                    android:textStyle="bold"
                    android:textColor="#F3856A"/>
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Kahvaltı"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_square_black"
                    android:layout_marginEnd="12dp"
                    />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Ana Yemek"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_square_black"
                    android:layout_marginEnd="12dp"
                    />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Tatlı"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_square_black"/>
            </LinearLayout>



        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/frame_recipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/horizontal_bar"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRecipes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                tools:listitem="@layout/rv_item_recipe"
               />
        </FrameLayout>


        <!--TODO: FAB Yukarı çıkma-->

    </androidx.constraintlayout.widget.ConstraintLayout>



</ScrollView>