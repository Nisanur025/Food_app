<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".GuestFragment"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title_guest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Misafir Planlayıcı"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!--Kişi sayısı -->
        <androidx.cardview.widget.CardView
            android:id="@+id/number_of_person"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title_guest"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="20sp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kaç kişi ağırlıyorsun?"
                    android:textColor="@color/light_grey"
                    android:textSize="18sp"
                    android:padding="20dp"
                    />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal|center_vertical"
                android:layout_marginTop="54dp"
                android:layout_marginBottom="12dp">

                <ImageButton
                    android:id="@+id/btn_num_person_minus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_minus_square"
                    app:tint="#6A6A6A"
                    android:contentDescription="eksi"/>

                <TextView
                    android:id="@+id/tv_num_person"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="25sp"
                    android:text="6"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="24dp"
                    android:textAlignment="center"/>

                <ImageButton
                    android:id="@+id/btn_num_person_plus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_plus_square"
                    app:tint="#6A6A6A"
                    android:contentDescription="artı"/>

            </LinearLayout>


        </androidx.cardview.widget.CardView>


        <!--Menü Seçme-->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/number_of_person"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menüyü Seç"
                android:textColor="@color/light_grey"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="34dp"
                android:textSize="18dp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/add_menu_guest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                android:text="Menü Ekle"
                app:backgroundTint="@null"
                android:background="@drawable/bg_dashed_outline"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="90dp"
                android:layout_marginBottom="24dp"/>



        </androidx.cardview.widget.CardView>


        <!--Todo: Menüdeki  olmayan malzemeleri Alışveriş listesine otomatik çıkartıp listeye eklenebilir-->
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>