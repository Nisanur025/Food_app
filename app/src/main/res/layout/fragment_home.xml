<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">



        <TextView
            android:id="@+id/hello_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Merhaba"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="16sp"
            android:textColor="#8C8B8B"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cook_question"
            android:text="Ne pişirelim?"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#B8B5B5"
            app:layout_constraintTop_toBottomOf="@id/hello_home"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginStart="24dp"

            />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/today_recipeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#2F4D3A"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="100dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bugünün yemeği · akşam"
                    android:textColor="#A8D9B9"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tavuklu sebze sote"
                    android:textColor="#EEF7EE"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    app:layout_constraintTop_toBottomOf="@id/tvLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="30 dk · 4 kişilik"
                    android:textColor="#C3DDC9"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/right_chevron"
                    app:tint="#C3DDC9"
                    app:layout_constraintBottom_toBottomOf="@id/tvMeta"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>



        <TextView
            android:id="@+id/warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/today_recipeCard"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/warning_bg"
            android:textSize="16sp"
            android:padding="10dp"
            android:textColor="#D59F5F"
            android:textStyle="bold"
            android:drawableStart="@drawable/warning"
            android:drawablePadding="25dp"
            android:text="3 malzeme yakında bitiyor:\n süt, yumurta, ıspanak">

        </TextView>


        <!--TODO : kategori butonları horizontal scrollView içerisine eklenecek-->

        <TextView
            android:id="@+id/categories_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/warning"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:text="Tarif kategorileri"
            android:textStyle="bold"
            android:textSize="20sp">

        </TextView>

        <HorizontalScrollView
            android:id="@+id/categories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbarSize="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/categories_tv">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/breakfast_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_categories_1"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="24dp"
                    android:text="Kahvaltı"
                    android:textSize="18sp"
                    android:textColor="#D04040">

                </Button>

                <Button
                    android:id="@+id/main_course"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_categories_0"
                    android:text="Ana yemek"
                    android:textColor="#5A5A5A"
                    android:textSize="18sp"
                    app:layout_constraintStart_toEndOf="@id/breakfast_btn"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="10dp">

                </Button>

                <Button
                    android:id="@+id/dessert_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_categories_0"
                    android:text="Tatlı"
                    android:textColor="#5A5A5A"
                    android:textSize="18sp"
                    app:layout_constraintStart_toEndOf="@id/main_course"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="10dp">

                </Button>

                <Button
                    android:id="@+id/guest_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_categories_0"
                    android:text="Misafir yemekleri"
                    android:textColor="#5A5A5A"
                    android:textSize="18sp"
                    app:layout_constraintStart_toEndOf="@id/dessert_btn"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="24dp">

                </Button>
            </LinearLayout>

        </HorizontalScrollView>
        <TextView
            android:id="@+id/suggest_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:text="Bu hafta önerilenler"
            android:textColor="#5A5A5A"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/categories"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp">

        </TextView>

        <!--Karşılaşılan sorun :Horizontal Scroll View 1 tane çocuğa sahip olabildiği için birden fazla butonu
        direkt altına koyamıyoruz. Butonları linear layout ile sarmalayıp tek çocukmuş gibi koyabiliriz-->

        <HorizontalScrollView
            android:id="@+id/suggest_sv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/suggest_tv"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:background="@drawable/suggest_btn0"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Mercimek Çorbası\n25 dk"
                    android:textAlignment="textStart"
                    android:textColor="#037368"
                    android:textSize="20sp"
                    android:paddingTop="10dp"
                    android:drawableTop="@drawable/soup">
                </Button>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:background="@drawable/suggest_btn1"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:text="Tavuklu Salata\n15 dk"
                    android:textAlignment="textStart"
                    android:textColor="#037368"
                    android:textSize="20sp"
                    android:paddingTop="10dp"
                    android:drawableTop="@drawable/salad">
                </Button>

            </LinearLayout>

        </HorizontalScrollView>
        <TextView
            android:id="@+id/all_recipes_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5A5A5A"
            android:textStyle="bold"
            android:text="Şipşak Tarifler"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/suggest_sv"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="@color/black"
            app:icon="@drawable/filter"
            app:iconSize="24dp"
            app:iconTint="#5A5A5A"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@id/all_recipes_tv"
            app:iconGravity="end"
            app:layout_constraintTop_toBottomOf="@id/suggest_sv"
            android:contentDescription="filtre">

        </com.google.android.material.button.MaterialButton>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/all_recipes_tv"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">

        </androidx.recyclerview.widget.RecyclerView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="84dp"
            android:src="@drawable/lightning"
            app:maxImageSize="40dp"
            app:backgroundTint="#F0D38181"
            android:contentDescription="asistan">


        </com.google.android.material.floatingactionbutton.FloatingActionButton>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>