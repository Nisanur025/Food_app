<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/hello_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_greeting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="0dp"
            android:layout_marginStart="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cook_question"
            android:text="@string/title_cook_question"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/hello_home"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginStart="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/today_recipeCard"
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:layout_constraintTop_toBottomOf="@id/cook_question"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/fire"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_fire"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_recipe_label"
                    android:textColor="@color/light_orange"
                    android:textSize="12sp"
                    android:layout_marginStart="15dp"
                    app:layout_constraintStart_toEndOf="@id/fire"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/today_recipe_title"
                    android:layout_marginStart="15dp"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron"
                    app:layout_constraintStart_toEndOf="@id/fire"
                    app:layout_constraintTop_toBottomOf="@id/tvLabel" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/today_recipe_meta"
                    android:layout_marginStart="15dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toEndOf="@id/fire"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_right_chevron"
                    app:layout_constraintBottom_toBottomOf="@id/tvMeta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/light_grey" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_vw_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/warning_bg"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/today_recipeCard">

            <TextView
                android:id="@+id/warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:textSize="16sp"
                android:padding="10dp"
                android:textColor="@color/light_orange"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_warning"
                android:drawablePadding="25dp"
                android:text="@string/warning_stock_message" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:text="@string/btn_add_to_shopping_list"
                app:icon="@drawable/ic_chef_hat"
                app:cornerRadius="30dp"
                app:iconSize="24dp"
                app:backgroundTint="@color/medium_orange"
                android:layout_marginTop="55dp"
                android:layout_marginBottom="10dp"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:focusable="true"
                android:clickable="true" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layout_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/card_vw_warning"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 1. KART: Tüm Tarifler -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/all_recipes_mc"
                style="@style/Widget.App.Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    style="@style/Widget.App.CardContent">

                    <ImageView
                        style="@style/Widget.App.CardIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_book"
                        android:background="@drawable/bg_square_purple" />

                    <TextView
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/card_all_recipes_title" />

                    <TextView
                        style="@style/TextAppearance.App.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/card_all_recipes_subtitle" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. KART: Alışveriş Listesi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_shop_list"
                style="@style/Widget.App.Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    style="@style/Widget.App.CardContent">

                    <ImageView
                        style="@style/Widget.App.CardIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_shopping_list"
                        android:background="@drawable/bg_square_green" />

                    <TextView
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/card_shop_list_title" />

                    <TextView
                        style="@style/TextAppearance.App.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/card_shop_list_subtitle" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!--Haftalık Menü Yazı-->
        <TextView
            android:id="@+id/weekly_menu"
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_weekly_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_cards"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp" />

        <!--Haftalık Menü Kart -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/weekly_menu_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weekly_menu"
            tools:listitem="@layout/item_day_menu"
            tools:itemCount="7" />

        <TextView
            android:id="@+id/all_recipes_tv"
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_quick_recipes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weekly_menu_layout"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.App.FilterButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@id/all_recipes_tv"
            app:layout_constraintTop_toBottomOf="@id/weekly_menu_layout"
            android:contentDescription="@string/cd_filter_button" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/all_recipes_tv"
            android:layout_marginVertical="24dp"
            android:layout_marginHorizontal="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>