<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ShopListFragment"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--Başlık-->
        <TextView
            android:id="@+id/tv_shop_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alışveriş Listesi"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!--Evdeki temel Malzemeler-->
        <androidx.cardview.widget.CardView
            android:id="@+id/basic_materials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_list"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="#48595959"
            app:cardCornerRadius="20dp"
            android:elevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgvw_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_home"
                    app:tint="#FF5722"
                    android:layout_marginTop="18dp"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tv_homeList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evdeki Temel Malzemeler"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/imgvw_home"
                    app:layout_constraintTop_toTopOf="parent"

                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6/6 Stokta"
                    android:textColor="@color/light_grey"
                    android:textSize="13sp"
                    android:layout_marginTop="25dp"
                    app:layout_constraintStart_toEndOf="@id/tv_homeList"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <TextView
                    android:id="@+id/tv_message_homelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bitenleri işaretle listeye eklensin."
                    android:textSize="14sp"
                    android:textColor="@color/light_grey"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgvw_home"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"/>

                <CheckBox
                    android:id="@+id/cb_salt"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Tuz"
                    android:background="@drawable/bg_square_black"
                    app:layout_constraintTop_toBottomOf="@id/tv_message_homelist"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    />
                <CheckBox
                    android:id="@+id/cb_black_pepper"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Karabiber"
                    android:background="@drawable/bg_square_black"
                    app:layout_constraintTop_toBottomOf="@id/tv_message_homelist"
                    app:layout_constraintStart_toEndOf="@id/cb_salt"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    />
                <CheckBox
                    android:id="@+id/cb_olive_oil"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="ZeytinYağı"
                    android:background="@drawable/bg_square_black"
                    app:layout_constraintTop_toBottomOf="@id/cb_salt"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    />
                <CheckBox
                    android:id="@+id/cb_flour"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Un"
                    android:background="@drawable/bg_square_black"
                    app:layout_constraintTop_toBottomOf="@id/cb_black_pepper"
                    app:layout_constraintStart_toEndOf="@id/cb_salt"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    />
                <CheckBox
                    android:id="@+id/cb_rice"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Pirinç"
                    android:background="@drawable/bg_square_black"
                    app:layout_constraintTop_toBottomOf="@id/cb_olive_oil"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    />
                <CheckBox
                    android:id="@+id/cb_sugar"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Şeker"
                    android:background="@drawable/bg_square_black"
                    app:layout_constraintTop_toBottomOf="@id/cb_flour"
                    app:layout_constraintStart_toEndOf="@id/cb_salt"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    />

                <ImageView
                    android:id="@+id/edit_larder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_edit"
                    app:tint="#FF5722"
                    android:layout_marginTop="18dp"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@id/cb_rice"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:id="@+id/tv_edit_larger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kiler listeni düzenle"
                    android:textColor="#FF5722"
                    android:layout_marginTop="18dp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constraintTop_toBottomOf="@id/cb_rice"
                    app:layout_constraintStart_toEndOf="@id/edit_larder"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="12dp"/>



            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.cardview.widget.CardView>


        <!--Kategoriler-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/basic_materials"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />








        

        
        <!--Yeni kategori ekleme girişi-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_category_items"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="#484C4C4C"
            android:layout_marginTop="12dp">
            <!--yeni kategori ekleme Butonu-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yeni Kategori Ekle"
                app:icon="@drawable/ic_plus_circle"
                app:iconTint="#FF5722"
                app:iconGravity="textStart"
                app:backgroundTint="@null"
                android:background="@drawable/bg_dashed_outline"
                android:textColor="@color/white"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rv_category_items"
                app:layout_constraintEnd_toEndOf="parent" />


        </LinearLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>



</ScrollView>