<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ShopListFragment"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Başlık -->
        <TextView
            android:id="@+id/tv_shop_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shop_list_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Evdeki Temel Malzemeler CardView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/basic_materials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_list"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="20dp"
            android:elevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/imgvw_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_home"
                    app:tint="@color/primary_orange"
                    android:layout_marginTop="18dp"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/home_materials_title"/>

                <TextView
                    android:id="@+id/tv_homeList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_materials_title"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/imgvw_home"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_materials_stock_count"
                    style="@style/SubtitleTextInfoStyle"
                    android:layout_marginTop="25dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_message_homelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SubtitleTextInfoStyle"
                    android:text="@string/home_materials_message"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgvw_home"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"/>

                <!-- Checkbox'lar -->
                <CheckBox
                    android:id="@+id/cb_salt"
                    style="@style/LarderCheckboxStyle"
                    android:text="@string/ingredient_salt"
                    app:layout_constraintTop_toBottomOf="@id/tv_message_homelist"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp" />

                <CheckBox
                    android:id="@+id/cb_black_pepper"
                    style="@style/LarderCheckboxStyle"
                    android:text="@string/ingredient_black_pepper"
                    app:layout_constraintTop_toBottomOf="@id/tv_message_homelist"
                    app:layout_constraintStart_toEndOf="@id/cb_salt"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="12dp" />

                <CheckBox
                    android:id="@+id/cb_olive_oil"
                    style="@style/LarderCheckboxStyle"
                    android:text="@string/ingredient_olive_oil"
                    app:layout_constraintTop_toBottomOf="@id/cb_salt"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp" />

                <CheckBox
                    android:id="@+id/cb_flour"
                    style="@style/LarderCheckboxStyle"
                    android:text="@string/ingredient_flour"
                    app:layout_constraintTop_toBottomOf="@id/cb_black_pepper"
                    app:layout_constraintStart_toEndOf="@id/cb_salt"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="12dp" />

                <CheckBox
                    android:id="@+id/cb_rice"
                    style="@style/LarderCheckboxStyle"
                    android:text="@string/ingredient_rice"
                    app:layout_constraintTop_toBottomOf="@id/cb_olive_oil"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp" />

                <CheckBox
                    android:id="@+id/cb_sugar"
                    style="@style/LarderCheckboxStyle"
                    android:text="@string/ingredient_sugar"
                    app:layout_constraintTop_toBottomOf="@id/cb_flour"
                    app:layout_constraintStart_toEndOf="@id/cb_salt"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="24dp"
                    android:layout_marginStart="12dp" />

                <ImageView
                    android:id="@+id/edit_larder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/primary_orange"
                    android:layout_marginTop="18dp"
                    android:layout_marginStart="24dp"
                    app:layout_constraintTop_toBottomOf="@id/cb_rice"
                    app:layout_constraintStart_toStartOf="parent"
                    android:contentDescription="@string/edit_larder_list"/>

                <TextView
                    android:id="@+id/tv_edit_larger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_larder_list"
                    android:textColor="@color/primary_orange"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toBottomOf="@id/cb_rice"
                    app:layout_constraintStart_toEndOf="@id/edit_larder"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Kategoriler RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/basic_materials"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Yeni Kategori Ekleme Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_new_product"
            app:icon="@drawable/ic_plus_circle"
            app:iconTint="@color/primary_orange"
            app:iconGravity="textStart"
            app:backgroundTint="@null"
            android:background="@drawable/bg_dashed_outline"
            android:textColor="@color/white"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_category_items"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>