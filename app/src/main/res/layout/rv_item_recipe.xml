<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRecipe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1A1A1A"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageRecipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="mercimek çorbası"
                tools:src="@drawable/img_mercimek_2" />


            <TextView
                android:id="@+id/textDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_duration_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#FFDCCF"
                android:textSize="16sp"
                tools:text="25 dk" />

            <!-- Favori ikonu: görselin sağ üstünde -->
            <ImageView
                android:id="@+id/iconFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_heart"
                android:contentDescription="favori ekle"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F1EFE8"
                android:textSize="14sp"
                android:textStyle="normal"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Mercimek çorbası" />

            <TextView
                android:id="@+id/textSubInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/light_grey"
                android:textSize="12sp"
                tools:text="Kolay" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>