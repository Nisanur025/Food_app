<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recipeDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipToPadding="false"
    android:paddingTop="10dp"
    android:paddingBottom="50dp"
    tools:context=".RecipeDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Resim -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photo_gallery"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Başlık ve Açıklama -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_recipe_title"
            style="@style/RecipeDetailTitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_recipe_description"
            style="@style/RecipeDetailDescriptionStyle" />

        <!-- Porsiyon ve Butonlar -->
        <LinearLayout
            android:id="@+id/layout_servings_stepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decrease_servings"
                style="@style/RecipeDetailStepperButtonStyle"
                android:contentDescription="@string/cd_decrease_servings"
                app:icon="@drawable/ic_minus_square" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_servings_count"
                style="@style/RecipeDetailStepperCountStyle"
                android:text="@string/default_servings_count" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_increase_servings"
                style="@style/RecipeDetailStepperButtonStyle"
                android:contentDescription="@string/cd_increase_servings"
                app:icon="@drawable/ic_plus_square" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_serving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_serving"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/text_secondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_cooking"
                style="@style/RecipeDetailPrimaryButtonStyle"
                android:text="@string/btn_start_cooking" />
        </LinearLayout>

        <!-- Malzeme Kartı -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ingredients"
            style="@style/RecipeDetailCardStyle"
            android:layout_marginHorizontal="24dp">

            <LinearLayout style="@style/RecipeDetailCardContentStyle">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_ingredients_header"
                    style="@style/RecipeDetailCardHeaderStyle"
                    android:text="@string/header_ingredients" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ingredients"
                    style="@style/RecipeDetailCardListStyle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Adım Kartı -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_steps"
            style="@style/RecipeDetailCardStyle"
            android:layout_marginHorizontal="24dp">

            <LinearLayout style="@style/RecipeDetailCardContentStyle">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/RecipeDetailCardHeaderStyle"
                    android:text="@string/header_steps" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_steps"
                    style="@style/RecipeDetailCardListStyle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Kişisel Not Kartı -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notes"
            style="@style/RecipeDetailCardStyle"
            android:layout_marginHorizontal="24dp">

            <LinearLayout style="@style/RecipeDetailCardContentStyle">

                <!-- Başlık satırı: ikon + başlık + kaydetme durumu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_note"
                        app:tint="@color/orange" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/RecipeDetailCardHeaderStyle"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/header_my_notes" />

                    <!-- Yazarken görünür -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_save_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_note_saved"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Not yazma alanı -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_personal_notes">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_personal_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:textColor="@color/text_secondary"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Yazarken görünür, boşken gizli -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_note"
                    style="@style/RecipeDetailPrimaryButtonStyle"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_save_note"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>