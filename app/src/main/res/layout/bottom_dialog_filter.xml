<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#191919"
    >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/viewHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#5A5A5A"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            />

        <TextView
            android:id="@+id/filter_recipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="Filtrele"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6078FF"
            android:text="Temizle"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/category_recipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kategori"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filter_recipe"
            android:textSize="18sp"
            android:textColor="#A39F9F"
            android:textStyle="bold"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"/>


        <LinearLayout
            android:id="@+id/first_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/category_recipe"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/breakfast_filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Kahvaltı"
                android:textSize="15sp"
                android:textColor="@color/black"
                app:backgroundTint="@null"
                android:background="@drawable/bg_white"/>
            <Button
                android:id="@+id/main_menu"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Ana Yemek"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="@null"
                android:background="@drawable/bg_square_black_stroke"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/soup_filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Çorba"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="@null"
                android:background="@drawable/bg_square_black_stroke"
                android:layout_marginStart="12dp"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/second_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/first_category">
            <Button
                android:id="@+id/dessert_filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Tatlı"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="@null"
                android:background="@drawable/bg_square_black_stroke"
                />


            <Button
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Salata"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="@null"
                android:background="@drawable/bg_square_black_stroke"
                app:layout_constraintStart_toEndOf="@id/dessert_filter"
                app:layout_constraintTop_toBottomOf="@id/breakfast_filter"
                android:layout_marginStart="12dp"/>
        </LinearLayout>


        <TextView
            android:id="@+id/time_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pişirme Süresi"
            app:layout_constraintTop_toBottomOf="@+id/second_category"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:textSize="18sp"
            android:textColor="#A39F9F"
            android:textStyle="bold"
            />


        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCookingTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="120.0"
            android:value="30.0"
            android:stepSize="5.0"
            android:layout_marginTop="8dp"
            app:thumbColor="#3A3A3C"
            app:trackColorActive="#7B7BAD"
            app:trackColorInactive="#2C2C2E"
            app:haloColor="@android:color/transparent"
            app:labelBehavior="gone"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/time_filter" />

        <!-- Alt Değer Yazıları (0 dk ve 120+ dk) -->
        <TextView
            android:id="@+id/tv_min_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 dk"
            android:textColor="#8E8E93"
            android:layout_marginStart="24dp"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/sliderCookingTime"
            app:layout_constraintTop_toBottomOf="@id/sliderCookingTime" />

        <TextView
            android:id="@+id/tv_max_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120+ dk"
            android:layout_marginEnd="24dp"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/sliderCookingTime"
            app:layout_constraintTop_toBottomOf="@id/sliderCookingTime" />
        <TextView
            android:id="@+id/difficulty_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zorluk"
            app:layout_constraintTop_toBottomOf="@+id/tv_min_time"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:textSize="18sp"
            android:textColor="#A39F9F"
            android:textStyle="bold"
            />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnEasy"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/difficulty_filter">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEasy"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Kolay"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/card_bg"
                app:strokeColor="#CB6C6C6C"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMedium"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Orta"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/card_bg"
                app:strokeColor="#CB6C6C6C"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Zor"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/card_bg"
                app:strokeColor="#CB6C6C6C"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/diet_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diyet / Etiketler"
            android:layout_marginStart="24dp"
            android:textSize="18sp"
            android:textColor="#A39F9F"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupDifficulty"
            android:layout_marginTop="24dp"/>
        <Button
            android:id="@+id/vegetarian_filter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Vejeteryan"
            android:textSize="15sp"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            android:background="@drawable/bg_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/diet_filter"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"/>

        <Button
            android:id="@+id/vegan_filter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Vegan"
            android:textSize="15sp"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            android:background="@drawable/bg_square_black_stroke"
            app:layout_constraintStart_toEndOf="@id/vegetarian_filter"
            app:layout_constraintTop_toBottomOf="@id/diet_filter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="24dp"/>
        <Button
            android:id="@+id/gluten_free_filter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Glutensiz"
            android:textSize="15sp"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            android:background="@drawable/bg_square_black_stroke"
            app:layout_constraintStart_toEndOf="@id/vegan_filter"
            app:layout_constraintTop_toBottomOf="@id/diet_filter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="24dp"/>

        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_white"
            android:text="Uygula"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vegetarian_filter"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

        </Button>
    </androidx.constraintlayout.widget.ConstraintLayout>




</ScrollView>