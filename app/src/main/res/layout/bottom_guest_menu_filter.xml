<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#191919"
    android:maxHeight="700dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/light_grey" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kategori ve hazırlık seç"
                android:textColor="#F2F2F0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="Sıfırla"
                android:textColor="#8C8C92"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2F2F35" />



        <!-- Uygula Butonu-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp">

            <!-- Kategori bölümü -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Kategori"
                android:textColor="#8C8C92"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="10dp"
                app:chipSpacingVertical="10dp"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCorba"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Çorba"
                    android:textColor="#F2F2F0"
                    app:checkedIconTint="#2F9E6E"
                    app:chipBackgroundColor="#296052"
                    app:chipStrokeColor="#2F9E6E"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnaYemek"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Ana yemek"
                    android:textColor="#F2F2F0"
                    app:checkedIconTint="#E0523F"
                    app:chipBackgroundColor="#3D1F1F"
                    app:chipStrokeColor="#E0523F"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTatli"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Tatlı"
                    android:textColor="#F2F2F0"
                    app:checkedIconTint="#D99A3D"
                    app:chipBackgroundColor="#906524"
                    app:chipStrokeColor="#D99A3D"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSalata"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Salata"
                    android:textColor="#F2F2F0"
                    app:checkedIconTint="#5A8FD6"
                    app:chipBackgroundColor="#295795"
                    app:chipStrokeColor="#5A8FD6"
                    app:chipStrokeWidth="1.5dp" />

            </com.google.android.material.chip.ChipGroup>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Metin Giriş Kutusu -->
                <EditText
                    android:id="@+id/etYourCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_square_black_stroke"
                    android:hint="Kendi kategorini oluştur."
                    android:padding="15dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/light_grey"
                    android:textSize="16sp" />

                <!-- Gönder Butonu -->
                <ImageButton
                    android:id="@+id/btnSendCategory"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_green"
                    android:contentDescription="Gönder"
                    android:src="@drawable/ic_send"
                    app:tint="#19382a" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutNewDishComposer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etDishName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_square_black_stroke"
                    android:hint="Menü adını yaz. (Örn : Yayla Çorbası)"
                    android:padding="15dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/light_grey"
                    android:textSize="16sp" />


            </LinearLayout>

            <!-- Hazırlık süresi bölümü -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:text="Hazırlık süresi"
                android:textColor="#8C8C92"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupPrepTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbHazir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@color/card_bg"
                    android:buttonTint="#7FC4DD"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="Hemen hazır"
                    android:textColor="#F2F2F0"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb1Gun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@color/card_bg"

                    android:buttonTint="#7FC4DD"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="1 gün önceden hazır"
                    android:textColor="#F2F2F0"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb2Gun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@color/card_bg"
                    android:buttonTint="#7FC4DD"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="2 gün önceden hazır"
                    android:textColor="#F2F2F0"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb3GunUstu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_bg"
                    android:layout_marginBottom="8dp"
                    android:buttonTint="#7FC4DD"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="3+ gün önceden hazır"
                    android:textColor="#F2F2F0"
                    android:textSize="14sp" />

            </RadioGroup>

            <!-- Kullanıcının eklediği özel hazırlık süreleri runtime'da buraya eklenir -->
            <RadioGroup
                android:id="@+id/radioGroupCustomPrepTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Kendi süreni ekle -->
            <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Metin Giriş Kutusu -->
                <EditText
                    android:id="@+id/etYourTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_square_black_stroke"
                    android:hint="Kendi süreni yaz."
                    android:padding="15dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/light_grey"
                    android:textSize="16sp" />

                <!-- Gönder Butonu -->
                <ImageButton
                    android:id="@+id/btnSendTime"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_green"
                    android:contentDescription="Gönder"
                    android:src="@drawable/ic_send"
                    app:tint="#19382a" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Filtreyi uygula"
            android:textColor="#141416"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#F2F2F0"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="24dp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>