<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo / Başlık -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:contentDescription="Uygulama Logosu"
            android:src="@drawable/ic_chef_hat" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Hesap Oluştur"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Lezzetli yemeklere ulaşmak için kayıt ol"
            android:textColor="@color/light_grey"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- Ad Soyad -->
        <EditText
            android:id="@+id/tillFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="Ad Soyad"
            android:padding="15dp"
            android:textColor="@color/white"
            android:textColorHint="@color/light_grey"
            android:drawableStart="@drawable/ic_profile"
            android:drawablePadding="15dp"
            android:layout_marginBottom="12dp"/>

        <!-- E-posta -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:textColor="@color/white"
            android:hint="Eposta"
            android:textColorHint="@color/light_grey"
            android:drawableStart="@drawable/ic_mail"
            android:drawablePadding="15dp"
            android:layout_marginBottom="12dp"
            />


        <!-- Şifre -->
        <EditText
            android:id="@+id/tillPassword"
            android:layout_width="match_parent"
            android:padding="15dp"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColorHint="@color/light_grey"
            android:hint="Şifre "
            android:textColor="@color/white"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="15dp"
            android:layout_marginBottom="12dp"/>

        <!-- Şifre Tekrar -->

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:textColorHint="@color/light_grey"
                android:inputType="textPassword"
                android:hint="Şifre Tekrar"
                android:textColor="@color/white"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="15dp"
                android:layout_marginBottom="12dp"/>

        <!-- Kullanım Koşulları -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/light_grey"
            android:text="Kullanım Koşulları ve Gizlilik Politikası'nı kabul ediyorum" />

        <!-- Kayıt Ol Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/green"
            android:text="Kayıt Ol"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Giriş Yap Linki -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zaten hesabın var mı?"
                android:textColor="@color/light_grey" />

            <TextView
                android:id="@+id/tvLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Giriş Yap"
                android:textColor="@color/orange"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>