<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Food_app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Food_app" parent="Base.Theme.Food_app" />
    <style name="DrawerRoundedCorner" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <!-- Checkbox'lar için ortak stil -->
    <style name="LarderCheckboxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_square_black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <!--  gri bilgilendirme TextView'ları için ortak stil -->
    <style name="SubtitleTextInfoStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/light_grey</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Filtre Butonları İçin Ortak Stil -->
    <style name="Widget.App.FilterButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="backgroundTint">@color/black</item>
        <item name="icon">@drawable/ic_filter</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">end</item>
    </style>

    <style name="FilterButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#2A2A2A</item>
        <item name="android:textColor">#B8B5B5</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Başlık / Açıklama -->
    <style name="RecipeDetailTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="RecipeDetailDescriptionStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Kart -->
    <style name="RecipeDetailCardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="RecipeDetailCardContentStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!--alt yazılar-->
    <style name="RecipeDetailCardHeaderStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Kart içindeki liste (Malzeme / Adım) -->
    <style name="RecipeDetailCardListStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:nestedScrollingEnabled">false</item>
        <item name="layoutManager">androidx.recyclerview.widget.LinearLayoutManager</item>
    </style>

    <!-- Porsiyon stepper -->
    <style name="RecipeDetailStepperButtonStyle" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!--Artı Eksi Yazı-->
    <style name="RecipeDetailStepperCountStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Ana buton (Pişirmeye Başla / Notu kaydet) -->
    <style name="RecipeDetailPrimaryButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_today_menu</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- ========== CARD ========== -->

    <!-- Ortak kart ayarları -->
    <style name="Widget.App.Card" parent="">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Koyu (#1E1E1E) kart: Tüm Tarifler, Alışveriş Listesi, gün kartları -->
    <style name="Widget.App.Card.Dark">
        <item name="cardBackgroundColor">#1E1E1E</item>
    </style>

    <!-- Kart içi dikey LinearLayout -->
    <!-- Kart içerikleri için genel kapsayıcı stili -->
    <style name="Widget.App.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>



    <!-- ========== TEXT ========== -->

    <!-- "Haftalık Menü" / "Hızlı Tarifler" başlıkları -->
    <style name="TextAppearance.App.SectionTitle" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Üstteki iki kartın başlığı -->
    <style name="TextAppearance.App.CardTitle" parent="">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Üstteki iki kartın alt başlığı -->
    <style name="TextAppearance.App.CardSubtitle" parent="">
        <item name="android:textColor">#9E9E9E</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Gün adı (Pzt, Sal...) -->
    <style name="TextAppearance.App.DayName" parent="">
        <item name="android:textColor">#A1A1A1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">1</item>
        <!-- Uzun gün adları ("Çarş - Bugün") tek satıra sığsın diye küçülür -->
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Planlanmış gün tarif adı -->
    <style name="TextAppearance.App.DayRecipe" parent="">
        <item name="android:textColor">#D4CDCD</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- "Planlanmadı" yazısı -->
    <style name="TextAppearance.App.DayEmpty" parent="">
        <item name="android:textColor">#5A5A5A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- ========== IMAGE ========== -->

    <!-- Üstteki iki kartın ikonu (arka plan layout'ta kalıyor) -->
    <style name="Widget.App.CardIcon" parent="">
        <item name="android:padding">10dp</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <!-- Gün kartı ikonu (check / plus) -->
    <style name="Widget.App.DayIcon" parent="">
        <item name="android:padding">10dp</item>
        <item name="tint">#8DD6C7</item>
    </style>
</resources>